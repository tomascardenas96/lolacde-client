# ──────────────────────────────────────────────────────────────
# Variables de entorno del cliente (Next.js)
# Copiá este archivo a .env.local y completá los valores.
# Solo las variables NEXT_PUBLIC_* quedan expuestas al navegador.
# ──────────────────────────────────────────────────────────────

# URL base de la API (incluye el prefijo /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010/api/v1

# URL pública del sitio (usada por sitemap.ts y robots.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
